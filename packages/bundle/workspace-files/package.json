{
  "name": "@deepseek-ai/dsh-bundle-workspace-files",
  "description": "Installable dsh profile bundle for the workspace-files plugin: the host Remote service plus the browser dock, self-mounted so it installs standalone via `dsh plugin --profile <name> add`",
  "version": "0.0.1-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/workspace-files"
  },
  "type": "module",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-workspace-files": "workspace:^",
    "@deepseek-ai/dsh-client-ui-workspace-files": "workspace:^"
  }
}
